{
  "name": "subtrack-worker",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.toml",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "build": "echo 'Nothing to build: wrangler bundles src/ at deploy time.'",
    "db:init": "wrangler d1 execute subtrack_db --remote --config ../wrangler.toml --file=./schema.sql",
    "db:init:local": "wrangler d1 execute subtrack_db --local --config ../wrangler.toml --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute subtrack_db --local --config ../wrangler.toml --file=./seed.sql",
    "test": "node test/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
